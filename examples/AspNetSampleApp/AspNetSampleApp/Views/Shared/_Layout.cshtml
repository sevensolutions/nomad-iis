<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>@ViewBag.Title - Sample ASP.NET Application</title>
    <link rel="stylesheet" href="~/Content/Site.css" />
    <script src="~/Scripts/site.js" defer></script>
</head>
<body>
    <header class="site-header">
        <div class="container">
            <a class="brand" href="@Url.Action("Index", "Home", new { area = "" })">
                <picture>
                    <source srcset="~/Content/images/logo-dark.svg" media="(prefers-color-scheme: dark)" />
                    <img class="brand-logo" src="~/Content/images/logo.svg" alt="Nomad IIS" width="137" height="32" />
                </picture>
                <span class="brand-name">Sample App</span>
            </a>
            <span class="machine" title="Name of the machine serving this page">@Environment.MachineName</span>
        </div>
    </header>

    <main class="container">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container">&copy; @DateTime.Now.Year Sample ASP.NET Application</div>
    </footer>
</body>
</html>
